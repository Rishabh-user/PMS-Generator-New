    },
    {
      "pattern": "(?i)\\bLTCS\\b|\\bA333\\b",
      "table": "LTCS"
    },
    {
      "pattern": "(?i)\\bGALV\\b|EPOXY|INTERNALLY\\s*COATED",
      "table": "CS"
    },
    {
      "pattern": "(?i)STAINLESS|^SS\\b",
      "table": "SS316L"
    },
    {
      "pattern": ".*",
      "table": "CS",
      "default": true
    }
