      "table": "Titanium_Gr2"
    },
    {
      "pattern": "(?i)C12200.*H80|(?<!\\w)H80",
      "table": "Copper_H80"
    },
    {
      "pattern": "(?i)C12200.*H55|(?<!\\w)H55",
