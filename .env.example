# Copy this file to .env and fill in your secrets.
# .env is git-ignored; .env.example is checked in as a template.

# Anthropic Claude — enables Tab 5 AI engineering notes.
# Without this key the rest of the app works; only Tab 5's AI card is disabled.
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE-ME

# Model + token budget for AI Notes calls.
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=2000

# App server.
APP_HOST=0.0.0.0
APP_PORT=8004
LOG_LEVEL=INFO
